# Copy this file to .env and fill in your Firebase project's config.
# .env is already in .gitignore — this will NOT be pushed to GitHub.
#
# EASIEST OPTION: paste the whole firebaseConfig object as one line of JSON.
# Firebase Console → Project Settings (gear icon) → General tab →
# "Your apps" → your web app → copy the firebaseConfig block, then convert
# it to JSON (put quotes around the keys too) on a single line:
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# ALTERNATIVE: six separate values instead of the one JSON line above.
# Only needed if you'd rather not deal with JSON formatting.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
